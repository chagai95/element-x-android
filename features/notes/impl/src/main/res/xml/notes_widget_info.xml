  ~
  ~ updatePeriodMillis is 0 on purpose: the system's periodic update is capped at 30 minutes and
  ~ wakes the device to run it, which is a poor trade for a widget whose content only changes when
  ~ the user changes a note. The app pushes an update instead, from the moment it knows.
  -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/notes_widget_description"
    android:initialLayout="@layout/widget_notes"
    android:minHeight="110dp"
    android:minWidth="180dp"
    android:previewLayout="@layout/widget_notes"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
